apiVersion: v1
kind: Secret
metadata:
  name: tic-tac-arena-secrets
  namespace: tic-tac-arena
type: Opaque
stringData:
  SUPABASE_URL: paste-supabase-url-here
  SUPABASE_ANON_KEY: paste-supabase-anon-key-here
  DATABASE_URL: paste-supabase-postgres-url-here
  SENTRY_DSN: paste-backend-sentry-dsn-here
  SENTRY_TEST_TOKEN: paste-temporary-sentry-test-token-here
